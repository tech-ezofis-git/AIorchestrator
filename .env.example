# --- LLM configuration -------------------------------------------------
# LiteLLM model string. Swap providers by changing this value only —
# no code changes required. Examples:
#   gpt-4.1-mini              (OpenAI, needs OPENAI_API_KEY)
#   claude-3-5-sonnet-20241022 (Anthropic, needs ANTHROPIC_API_KEY)
#   gemini/gemini-1.5-pro      (Google, needs GEMINI_API_KEY)
#   ollama/llama3              (local, needs OLLAMA_API_BASE)
LLM_MODEL=gpt-4.1-mini

# Eval harness (Phase 5c) only — see app/evals/. Model used for LLM-judge
# scoring (app/evals/scoring.py); defaults to LLM_MODEL if unset. Not read
# by the running service at all, only by `python -m app.evals.run`.
# JUDGE_MODEL=gpt-4.1

# Embedding model for Search/RAG (Phase 2) — same pattern as LLM_MODEL,
# also routed through LiteLLM. Swap providers by changing this value only.
#   text-embedding-3-small     (OpenAI, needs OPENAI_API_KEY, 1536-dim)
#   voyage/voyage-2            (Voyage, needs VOYAGE_API_KEY)
# Note: pgvector's embedding column is a fixed size (see
# db/migrations/0001_create_documents_and_chunks.sql) — switching to a
# model with a different output dimension needs a migration change too.
EMBEDDING_MODEL=text-embedding-3-small

# Set only the key matching your LLM_MODEL/EMBEDDING_MODEL — LiteLLM picks
# the right one automatically.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Model presets (Test Console) ---------------------------------------
# Used by app/llm/model_presets.py. Copy this file to .env and fill in
# real keys locally — .env is gitignored and never pushed.
# Default: ezofis-gpu-box → openai/qwen3.5-9b on ezqwenmac ACI
QWEN_MAC_API_KEY=
# South India: gpt-4.1-nano, gpt-5-nano, gpt-4.1-mini (ezazopenai)
AZURE_SOUTH_INDIA_API_KEY=
# East US:     gpt-4o-mini (api-4omin-ez)
AZURE_EAST_US_API_KEY=

# --- Infra ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://orchestrator:orchestrator@postgres:5432/orchestrator
# Shared ezofis catalog (agents / models / tenant model selection) — not a tenant DB.
# Put the real password in local .env only. Azure requires SSL.
# CATALOG_DATABASE_URL=postgresql://v6dbadmin:PASSWORD@ezv6psql.postgres.database.azure.com:5432/ezofis_catalog_new?sslmode=require
# Optional — keep small on shared Azure Flexible Server (default 1 / 3)
# DATABASE_POOL_MIN_SIZE=1
# DATABASE_POOL_MAX_SIZE=3

# --- App -------------------------------------------------------------
APP_NAME=ai-orchestrator
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=86400
# How long a Mail draft's pending action stays confirmable (Phase 3d).
PENDING_ACTION_TTL_SECONDS=600

# --- Guardrails (Phase 4a) ---------------------------------------------
# Fixed-window rate limit, keyed by session_id, applied to both /chat and
# /actions/{action_id}/confirm — see app/control/rate_limiter.py.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Response caching (Phase 5b) ----------------------------------------
# See app/control/response_cache.py. Long TTL for the query embedding (a
# pure function of text+model — never stale); short TTL for Search's full
# result and Forecast's narration (both are a point-in-time view over data
# that can change — the short TTL is the only staleness mitigation this
# phase implements).
EMBEDDING_CACHE_TTL_SECONDS=86400
SEARCH_RESULT_CACHE_TTL_SECONDS=300
FORECAST_NARRATION_CACHE_TTL_SECONDS=300

# --- OCR document extraction --------------------------------------------
# Azure Paddle (or compatible) extract_text endpoint.
OCR_EXTRACT_URL=https://ez-container-app.calmsmoke-6661997a.southindia.azurecontainerapps.io/api/extract_text
OCR_ENGINE=paddle
# Optional structuring models (default to LLM_MODEL when unset).
# OCR_DEFAULT_MODEL=
# OCR_FALLBACK_MODEL=
OCR_MAX_PAGES=5
OCR_MAX_RECOMMENDED_FIELDS=15
OCR_ALLOWED_HOST_SUFFIXES=.blob.core.windows.net
OCR_DOWNLOAD_TIMEOUT_SECONDS=60
OCR_MAX_FILE_BYTES=26214400
# Azure Blob download auth — put the real connection string in .env only
# (never commit AccountKey). Example shape:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=v6storage;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
# Relative blob paths: container ezts{tenantid without hyphens}. Override prefix if needed.
# AZURE_BLOB_CONTAINER_PREFIX=ezts

# --- Ezofis cloud API (AP document jobs) --------------------------------
# Auth + billing + PO/vendor master lookups for intent=ap skills.
# Leave login empty locally to use mock credits/masters (unit tests).
EZOFIS_API_BASE=https://cloud.ezofis.com/api
EZOFIS_LOGIN_EMAIL=
EZOFIS_LOGIN_PASSWORD=
EZOFIS_ENV=trial
# EZOFIS_TIMEOUT_SECONDS=30
# AP_LLM_PLANNER=false
# AP_AMOUNT_TOLERANCE=0.02
# AP_APPROVED_THRESHOLD=80
# AP_PARTIAL_THRESHOLD=50
# Per-tenant AP DB on the same host as DATABASE_URL: ezofis_Tenant_{first 8 of tenant_id}.
# Empty prefix keeps AP on the main database (local docker).
# AP_TENANT_DB_PREFIX=ezofis_Tenant_
# Workflow step name used to resolve ActivityId from workflow.WorkflowSteps.
# AP_AGENT_WORKFLOW_STEP_NAME=AP AGENT 1

# --- Agent skill packs (Summary / OCR LLM instructions) -----------------
# External SKILL.md + rules/*.mdc. Defaults to ./skills in the repo.
# Customers can point at their own packs without code changes.
# AGENT_SKILLS_ROOT=/path/to/skills
# SUMMARY_SKILL_DIR=/path/to/skills/summary
# OCR_SKILL_DIR=/path/to/skills/ocr
# INSIGHT_SKILL_DIR=/path/to/skills/insight

# --- Local Prometheus + Grafana (Phase 5e) ------------------------------
# Only read by docker-compose.yml's grafana service (via ${VAR} shell-style
# substitution) — NOT by the app itself, and not part of app/config.py's
# Settings. Local dev only; change before exposing Grafana beyond
# localhost. See "Local Prometheus + Grafana (Phase 5e)" in the README.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
